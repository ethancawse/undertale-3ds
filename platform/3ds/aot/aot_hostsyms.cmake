# Lists the main program's symbols that the AOT modules use (source/ctr_aot_module.h): every symbol the modules'
# objects refer to without defining it. Writes aot_hostsyms.h (their count) and aot_hostsyms.c (their addresses),
# which is compiled into the main program, where the references also keep --gc-sections from dropping anything a
# module calls, and into each module, whose copy holds the addresses it was linked against. Only rewritten when the
# list changes.
#
# usage: cmake -DNM=<nm> -DOUT_DIR=<dir> -DOBJECTS=<object|object|...> [-DGAME=<game>] -P aot_hostsyms.cmake
string(REPLACE "|" ";" objects "${OBJECTS}")
set(undefined "")
set(defined "")
foreach(obj IN LISTS objects)
    execute_process(COMMAND "${NM}" -u "${obj}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${NM} -u ${obj} failed")
    endif()
    string(REGEX MATCHALL "U [^\r\n]+" refs "${out}")
    foreach(r IN LISTS refs)
        string(SUBSTRING "${r}" 2 -1 name)
        list(APPEND undefined "${name}")
    endforeach()
    execute_process(COMMAND "${NM}" -g --defined-only "${obj}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${NM} -g ${obj} failed")
    endif()
    string(REGEX MATCHALL "[0-9a-fA-F]+ [A-Za-z] [^\r\n]+" defs "${out}")
    foreach(d IN LISTS defs)
        string(REGEX REPLACE "^[0-9a-fA-F]+ [A-Za-z] " "" name "${d}")
        list(APPEND defined "${name}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES undefined)
if(defined)
    list(REMOVE_ITEM undefined ${defined})
endif()
list(SORT undefined)
list(LENGTH undefined count)

set(h "// Generated by platform/3ds/aot/aot_hostsyms.cmake.\n#define AOT_HOST_SYMBOL_COUNT ${count}\n")
set(c "// Generated by platform/3ds/aot/aot_hostsyms.cmake: the main program's symbols the AOT modules use.\n")
string(APPEND c "#include <stdint.h>\n\n#include \"aot_hostsyms.h\"\n\n")
set(i 0)
set(items "")
set(numeric_parser "")
foreach(name IN LISTS undefined)
    set(import "${name}")
    if(name STREQUAL "strtod" OR name STREQUAL "strtof")
        if(numeric_parser AND NOT numeric_parser STREQUAL name)
            message(FATAL_ERROR "AOT numeric imports mix strtod and strtof; preserve their distinct return ABIs")
        endif()
        set(numeric_parser "${name}")
        # Both the host and module validation tables must contain the actual
        # safe target, not the main program's underlying libc implementation.
        set(import "RValue_numericStrtod")
    endif()
    string(APPEND c "extern char aotHostSym${i}[] __asm__(\"${import}\");\n")
    string(APPEND items "    (uintptr_t) aotHostSym${i},\n")
    math(EXPR i "${i} + 1")
endforeach()
if(count EQUAL 0)
    set(items "    0,\n")
endif()
string(APPEND c "\n#ifdef CTR_AOT_MODULE\n#define AOT_HOST_SYMBOLS aotmHostSymbols\n#else\n#define AOT_HOST_SYMBOLS ctrAotHostSymbols\n")
# Placement padding: the raw-main 65726574 DR host table occupied 74 words here.
# Keep its engine-address bytes in ordinary .rodata, as in the original object; the live table may grow late.
# This is NOT a second validation table: the module and loader still use the complete live list.
set(slot74
    GMLArray_decRef
    GMLArray_incRef
    GMLMethod_decRef
    GMLMethod_incRef
    Instance_getInstanceId
    Instance_structDecRef
    Instance_structIncRef
    IntRValueHashMap_getOrInsertUndefined
    RValue_asciiStrings
    RValue_gameStringsSize
    RValue_gameStringsStart
    0
    __aeabi_idivmod
    __aeabi_l2d
    abort
    aotCallBuiltin
    aotCallScript
    aotCeilOut
    aotCmpStrings
    aotDeopt
    aotEpoch
    aotFloorOut
    aotFmodOut
    aotFreeCopy
    aotGrew
    aotResolveLocals
    aotSiteBreak
    aotSiteBreakPopAF
    aotSiteDup
    aotSiteMember1
    aotSiteMember2
    aotSitePop
    aotSitePopAF
    aotSitePopArray
    aotSitePopVar
    aotSitePush
    aotSitePushArray
    aotSitePushBltn
    aotSitePushGlb
    aotSiteSelfBltn
    aotSlotWrite
    aotx_executeLoop
    aotx_fusedAccessorCall
    aotx_handleAddSlow
    aotx_handleAnd
    aotx_handleCall
    aotx_handleCallV
    aotx_handleCmp
    aotx_handleConv
    aotx_handleDiv
    aotx_handleMod
    aotx_handleMulSlow
    aotx_handleNeg
    aotx_handleNot
    aotx_handleOr
    aotx_handlePopEnv
    aotx_handlePushEnv
    aotx_handleRem
    aotx_handleShl
    aotx_handleShr
    aotx_handleSubSlow
    aotx_popArrayElementIntoSlot
    aotx_scriptFallthroughReturnValue
    aotx_stackPushTyped
    aotx_tryFusedAccessorCall
    cos
    free
    logError
    memmove
    memset
    sin
    strdup
    RValue_numericStrtod
    vLogError
)
list(LENGTH slot74 slot_count)
if(NOT slot_count EQUAL 74)
    message(FATAL_ERROR "The frozen host placement slot must stay 74 words")
endif()
string(APPEND c "const uint32_t ctrAotHostSymbolCount = AOT_HOST_SYMBOL_COUNT;\n")
set(slot_items "")
set(slot_index 0)
foreach(name IN LISTS slot74)
    if(name STREQUAL "0")
        # A retired import (aotclean, 2026-10-21: VM_nativeLoop): the word stays, zero.
        string(APPEND slot_items "    0,\n")
    else()
        string(APPEND c "extern char aotSlotSym${slot_index}[] __asm__(\"${name}\");\n")
        string(APPEND slot_items "    (uintptr_t) aotSlotSym${slot_index},\n")
    endif()
    math(EXPR slot_index "${slot_index} + 1")
endforeach()
string(APPEND c "// Placement padding only: retain raw main's 296-byte address slot.\n")
string(APPEND c "__attribute__((used)) const uintptr_t ctrAotHostSymbols_slot74[74] = {\n${slot_items}};\n")
string(APPEND c "#endif\n")
if(GAME STREQUAL "deltarune")
    # DELTARUNE (aotclean G1): typed regions made from the player's data use main-program
    # helpers the old hand list never did, so the live table grows. It lives at the end of the late text block
    # (.rodata.late.aotclean, platform/3ds/late_reserve.ld) with a fixed capacity of AOT_HOST_CAPACITY words, zero past
    # the count (the loader compares only the count), so that its growth moves nothing. Its former place in
    # .rodata.late.typed3 keeps a never-read placeholder holding the 81 addresses the table held there (the list below,
    # frozen like slot74), so every later late constant keeps its address. Checked by tools/analysis/check_host_slot.py.
    # Past the capacity the build stops: growing it is a deliberate layout move.
    set(AOT_HOST_CAPACITY 128)
    if(count GREATER AOT_HOST_CAPACITY)
        message(FATAL_ERROR "The AOT modules use ${count} main-program symbols, more than the host table's "
                            "${AOT_HOST_CAPACITY}-word capacity (aot_hostsyms.cmake): growing it moves the late text")
    endif()
    set(slot81
        GMLArray_decRef GMLArray_incRef GMLMethod_decRef GMLMethod_incRef
        Instance_getInstanceId Instance_structDecRef Instance_structIncRef IntRValueHashMap_getOrInsertUndefined
        RValue_asciiStrings RValue_gameStringsSize RValue_gameStringsStart VMBuiltins_getVariable
        __aeabi_idivmod __aeabi_l2d abort aotCallBuiltin
        aotCallScript aotCeilOut aotCmpStrings aotDeopt
        aotEpoch aotFloorOut aotFmodOut aotFreeCopy
        aotGrew aotResolveInlineBindings aotResolveLocals aotSiteBreak
        aotSiteBreakPopAF aotSiteDup aotSiteMember1 aotSiteMember2
        aotSitePop aotSitePopAF aotSitePopArray aotSitePopVar
        aotSitePush aotSitePushArray aotSitePushBltn aotSitePushGlb
        aotSiteSelfBltn aotSlotWrite aotTypedMathDegtorad aotTypedMathLengthdirX
        aotTypedMathLengthdirY aotx_executeLoop aotx_fusedAccessorCall aotx_handleAddSlow
        aotx_handleAnd aotx_handleCall aotx_handleCallV aotx_handleCmp
        aotx_handleConv aotx_handleDiv aotx_handleMod aotx_handleMulSlow
        aotx_handleNeg aotx_handleNot aotx_handleOr aotx_handlePopEnv
        aotx_handlePush aotx_handlePushBltn aotx_handlePushEnv aotx_handleRem
        aotx_handleShl aotx_handleShr aotx_handleSubSlow aotx_popArrayElementIntoSlot
        aotx_scriptFallthroughReturnValue aotx_stackPushTyped aotx_tryFusedAccessorCall aotx_tryPushStructMember
        cos free logError memmove
        memset sin strdup RValue_numericStrtod
        vLogError
    )
    list(LENGTH slot81 slot81_count)
    if(NOT slot81_count EQUAL 81)
        message(FATAL_ERROR "The frozen typed3 host placeholder must stay 81 words")
    endif()
    string(APPEND c "#ifndef CTR_AOT_MODULE\n")
    set(slot81_items "")
    set(slot_index 0)
    foreach(name IN LISTS slot81)
        string(APPEND c "extern char aotSlot81Sym${slot_index}[] __asm__(\"${name}\");\n")
        string(APPEND slot81_items "    (uintptr_t) aotSlot81Sym${slot_index},\n")
        math(EXPR slot_index "${slot_index} + 1")
    endforeach()
    string(APPEND c "// Placement padding only: the host table's former 324-byte place in .rodata.late.typed3.\n")
    string(APPEND c "__attribute__((used, section(\".rodata.late.typed3\"))) const uintptr_t ctrAotHostSymbols_slot81[81] = {\n${slot81_items}};\n")
    string(APPEND c "#define AOT_HOST_PLACEMENT __attribute__((section(\".rodata.late.aotclean\")))\n#define AOT_HOST_CAPACITY ${AOT_HOST_CAPACITY}\n")
    string(APPEND c "#else\n#define AOT_HOST_PLACEMENT\n#define AOT_HOST_CAPACITY\n#endif\n")
    string(APPEND c "extern const uintptr_t AOT_HOST_SYMBOLS[];\nAOT_HOST_PLACEMENT const uintptr_t AOT_HOST_SYMBOLS[AOT_HOST_CAPACITY] = {\n${items}};\n")
else()
    string(APPEND c "#ifdef CTR_AOT_MODULE\n#define AOT_HOST_PLACEMENT\n#else\n#define AOT_HOST_PLACEMENT __attribute__((section(\".rodata.late.typed3\")))\n#endif\n")
    string(APPEND c "extern const uintptr_t AOT_HOST_SYMBOLS[];\nAOT_HOST_PLACEMENT const uintptr_t AOT_HOST_SYMBOLS[] = {\n${items}};\n")
endif()

set(parser_link "# Generated by aot_hostsyms.cmake. Module-only parser resolution.\nset(AOTM_NUMERIC_PARSER \"${numeric_parser}\")\n")
foreach(pair "aot_hostsyms.h;h" "aot_hostsyms.c;c" "aot_numeric_string.cmake;parser_link")
    list(GET pair 0 file)
    list(GET pair 1 var)
    set(old "")
    if(EXISTS "${OUT_DIR}/${file}")
        file(READ "${OUT_DIR}/${file}" old)
    endif()
    if(NOT old STREQUAL "${${var}}")
        file(WRITE "${OUT_DIR}/${file}" "${${var}}")
    endif()
endforeach()
