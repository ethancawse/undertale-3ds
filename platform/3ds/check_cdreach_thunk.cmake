# creddodge tbox: drawTextImpl's string test calls cdReachBox, an assembly thunk (ctr_renderer.c's end) that passes r9
# on as cdReachBoxLen's text length. C cannot promise r9 holds textLen at that call, so this post-link check proves it
# on every build that has the thunk, and deletes the ELF otherwise (c26rev r19 F1):
#   1. cdReachBox is exactly `mov r3, r9; b cdReachBoxLen` (8 B);
#   2. drawTextImpl has exactly one direct call to it (bl cdReachBox) and no other branch to it;
#   3. the four words after that call are the source's next use of textLen, (float) textLen * reach->advance, read from
#      r9: vmov sA, r9 / vldr sC, [r0, #4] / vcvt.f32.s32 sA, sA / vmul.f32 sD, sA, sC (either operand order), vldr
#      anywhere before the vmul, vmov before vcvt before vmul, nothing else among them. r9 is callee-saved, so r9 after
#      the call is r9 at the call, and r0 is the call's result (reach; advance at offset 4, a _Static_assert in C).
# The same recognizer as tools/analysis/check_creddodge_layout.py's prove_r9_textlen, without its baseline ELF, so it
# also holds for builder builds with layout pins off or another compiler. 0 B at run time.
#   cmake -DELF=... -DNM=...-nm -DOBJDUMP=...-objdump -DEXPECT=1|0 -P check_cdreach_thunk.cmake
# EXPECT=1: the configuration compiles the thunk (UNDERTALE without CTRPORT_RENDER_TIMING), so it must be there.
# EXPECT=0: it must not be there either, unless it passes the same checks.
function(cdreach_fail why)
    file(REMOVE "${ELF}")
    message(FATAL_ERROR "cdreach thunk check: ${why}. ${ELF} deleted: r9 may no longer hold textLen at the cdReachBox "
                        "call (see ctr_renderer.c's tbox notes and tools/analysis/check_creddodge_layout.py --unit tbox).")
endfunction()

execute_process(COMMAND "${NM}" -S --defined-only "${ELF}" OUTPUT_VARIABLE symbols RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    cdreach_fail("could not read the symbols")
endif()
string(REGEX MATCHALL "[0-9a-f]+ [0-9a-f]+ [tT] cdReachBox[\r\n]" thunk "${symbols}")
list(LENGTH thunk thunks)
if(thunks EQUAL 0)
    if(EXPECT)
        cdreach_fail("cdReachBox is missing")
    endif()
    if(symbols MATCHES "[tT] cdReachBoxLen[\r\n]")
        cdreach_fail("cdReachBoxLen is there without the cdReachBox thunk")
    endif()
    message(STATUS "cdreach thunk check: no thunk in this configuration")
    return()
endif()
if(NOT thunks EQUAL 1)
    cdreach_fail("${thunks} cdReachBox symbols")
endif()
string(REGEX MATCH "([0-9a-f]+) ([0-9a-f]+) [tT] cdReachBox[\r\n]" m "${symbols}")
set(thunk_at "${CMAKE_MATCH_1}")
math(EXPR thunk_size "0x${CMAKE_MATCH_2}")
string(REGEX MATCHALL "[0-9a-f]+ [0-9a-f]+ [tT] cdReachBoxLen[\r\n]" helper "${symbols}")
list(LENGTH helper helpers)
string(REGEX MATCHALL "[0-9a-f]+ [0-9a-f]+ [tT] drawTextImpl[\r\n]" caller "${symbols}")
list(LENGTH caller callers)
if(NOT thunk_size EQUAL 8 OR NOT helpers EQUAL 1 OR NOT callers EQUAL 1)
    cdreach_fail("cdReachBox is ${thunk_size} B (expected 8), ${helpers} cdReachBoxLen and ${callers} drawTextImpl symbols (expected 1 each)")
endif()
string(REGEX MATCH "([0-9a-f]+) [0-9a-f]+ [tT] cdReachBoxLen[\r\n]" m "${symbols}")
math(EXPR helper_at "0x${CMAKE_MATCH_1}" OUTPUT_FORMAT HEXADECIMAL)
string(REGEX MATCH "([0-9a-f]+) ([0-9a-f]+) [tT] drawTextImpl[\r\n]" m "${symbols}")
math(EXPR caller_at "0x${CMAKE_MATCH_1}" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR caller_end "0x${CMAKE_MATCH_1} + 0x${CMAKE_MATCH_2}" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR thunk_start "0x${thunk_at}" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR thunk_end "0x${thunk_at} + 8" OUTPUT_FORMAT HEXADECIMAL)

# objdump line: "  1a2b3c:\te1a03009 \tmov\tr3, r9" -> "mov r3, r9" (comments after @ or ; dropped).
function(cdreach_disasm start stop out)
    execute_process(COMMAND "${OBJDUMP}" -d --no-show-raw-insn "--start-address=${start}" "--stop-address=${stop}" "${ELF}"
                    OUTPUT_VARIABLE text RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        cdreach_fail("objdump failed on ${start}..${stop}")
    endif()
    string(REPLACE ";" "@" text "${text}")
    string(REGEX REPLACE "\r" "" text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(result "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^ *([0-9a-f]+):[ \t]+(.*)$")
            set(addr "${CMAKE_MATCH_1}")
            string(REGEX REPLACE "[ \t]*@.*$" "" ins "${CMAKE_MATCH_2}")
            string(REGEX REPLACE "[ \t]+" " " ins "${ins}")
            string(STRIP "${ins}" ins)
            list(APPEND result "${addr}|${ins}")
        endif()
    endforeach()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# 1. The thunk itself.
cdreach_disasm(${thunk_start} ${thunk_end} body)
list(LENGTH body n)
string(REGEX REPLACE "^0x0*" "" helper_hex "${helper_at}")
if(NOT n EQUAL 2)
    cdreach_fail("cdReachBox decodes to ${n} instructions: ${body}")
endif()
list(GET body 0 i0)
list(GET body 1 i1)
string(REGEX REPLACE "^[0-9a-f]+\\|" "" i0 "${i0}")
string(REGEX REPLACE "^[0-9a-f]+\\|" "" i1 "${i1}")
if(NOT i0 STREQUAL "mov r3, r9" OR NOT i1 MATCHES "^b 0*${helper_hex} <cdReachBoxLen>$")
    cdreach_fail("cdReachBox is '${i0}; ${i1}', expected 'mov r3, r9; b ${helper_hex} <cdReachBoxLen>'")
endif()

# 2. Its one caller, and 3. the four words after the call.
cdreach_disasm(${caller_at} ${caller_end} code)
set(sites "")
set(others "")
set(index 0)
foreach(entry IN LISTS code)
    if(entry MATCHES "<cdReachBox(\\+0x[0-9a-f]+)?>")
        if(entry MATCHES "^[0-9a-f]+\\|bl [0-9a-f]+ <cdReachBox>$")
            list(APPEND sites ${index})
        else()
            list(APPEND others "${entry}")
        endif()
    endif()
    math(EXPR index "${index} + 1")
endforeach()
list(LENGTH sites nsites)
if(NOT nsites EQUAL 1 OR others)
    cdreach_fail("drawTextImpl has ${nsites} bl cdReachBox (expected 1) and other references '${others}'")
endif()
list(LENGTH code ncode)
math(EXPR first "${sites} + 1")
math(EXPR last "${sites} + 4")
if(last GREATER_EQUAL ncode)
    cdreach_fail("the cdReachBox call is too near drawTextImpl's end")
endif()
set(after "")
foreach(k RANGE ${first} ${last})
    list(GET code ${k} entry)
    string(REGEX REPLACE "^[0-9a-f]+\\|" "" entry "${entry}")
    list(APPEND after "${entry}")
endforeach()
set(mov -1)
set(ld -1)
set(movs 0)
set(lds 0)
set(k 0)
foreach(ins IN LISTS after)
    if(ins MATCHES "^vmov s([0-9]+), r9$")
        set(mov ${k})
        set(a ${CMAKE_MATCH_1})
        math(EXPR movs "${movs} + 1")
    elseif(ins MATCHES "^vldr s([0-9]+), \\[r0, #4\\]$")
        set(ld ${k})
        set(c ${CMAKE_MATCH_1})
        math(EXPR lds "${lds} + 1")
    endif()
    math(EXPR k "${k} + 1")
endforeach()
if(NOT movs EQUAL 1 OR NOT lds EQUAL 1 OR a EQUAL c)
    cdreach_fail("the words after the call are '${after}': no single vmov sA, r9 and vldr sC, [r0, #4]")
endif()
set(cvt -1)
set(mul -1)
set(cvts 0)
set(muls 0)
set(k 0)
foreach(ins IN LISTS after)
    if(ins STREQUAL "vcvt.f32.s32 s${a}, s${a}")
        set(cvt ${k})
        math(EXPR cvts "${cvts} + 1")
    elseif(ins MATCHES "^vmul\\.f32 s[0-9]+, s(${a}, s${c}|${c}, s${a})$")
        set(mul ${k})
        math(EXPR muls "${muls} + 1")
    endif()
    math(EXPR k "${k} + 1")
endforeach()
if(NOT cvts EQUAL 1 OR NOT muls EQUAL 1 OR NOT mov LESS cvt OR NOT cvt LESS mul OR NOT ld LESS mul)
    cdreach_fail("the words after the call are '${after}', not (float) r9 * [r0, #4] in order")
endif()
message(STATUS "cdreach thunk check: cdReachBox = mov r3, r9; b cdReachBoxLen; one call in drawTextImpl, then '${after}'")
