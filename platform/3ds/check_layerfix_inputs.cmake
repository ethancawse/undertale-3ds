# A new/renamed GCC section would otherwise silently escape retained input order.
# The final nm gate remains mandatory: this check only detects missing declarations.
file(READ "${CMAKE_CURRENT_LIST_DIR}/late_reserve.ld" late_layout)
string(REGEX MATCHALL "[.]text[.]late[.][A-Za-z0-9_]+" registered_late "${late_layout}")
foreach(stem runner vm_builtins)
    file(GLOB_RECURSE objects "${OBJECT_DIR}/${stem}.o" "${OBJECT_DIR}/${stem}.c.o")
    list(LENGTH objects count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "layerfix: expected one ${stem} object, found ${count}")
    endif()
    file(READ "${ENGINE_DIR}/src/${stem}_layerfix_layout.inc" layout)
    string(REGEX MATCHALL "LAYERFIX_(INPUT|SLOT)\\(\"[.]text[.][^\"]+\"" declarations "${layout}")
    set(declared)
    foreach(declaration IN LISTS declarations)
        string(REGEX REPLACE "^[^\"]*\"([^\"]+)\"$" "\\1" name "${declaration}")
        list(APPEND declared "${name}")
    endforeach()
    execute_process(COMMAND "${OBJDUMP}" -h ${objects}
        RESULT_VARIABLE result OUTPUT_VARIABLE headers ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT result EQUAL 0 OR NOT errors STREQUAL "")
        message(FATAL_ERROR "layerfix: cannot inspect ${stem}: ${result} ${errors}")
    endif()
    string(REGEX MATCHALL "[ \t][.]text[.][^ \t\r\n]+" inputs "${headers}")
    foreach(input IN LISTS inputs)
        string(STRIP "${input}" input)
        # Explicitly owned late code is consumed by late_reserve.ld, never by
        # the ordinary text inputs whose order these declarations preserve.
        list(FIND registered_late "${input}" late_index)
        if(NOT late_index EQUAL -1)
            continue()
        endif()
        list(FIND declared "${input}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "layerfix: undeclared ${stem} input ${input}; regenerate tools/analysis/prepare_layerfix_slots.py and repeat the full nm gate")
        endif()
    endforeach()
endforeach()
