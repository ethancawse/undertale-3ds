# Writes OUT, a header defining CTRPORT_COMMIT_TEXT as git's short commit for SOURCE_DIR (with "-dirty" when tracked
# files have changes), for the log header and the boot screen. The `ctrport_build_id` target runs this on every
# build, so the ID follows every commit, merge and checkout without a reconfigure. OUT is only rewritten when the ID
# changes, so a build at the same commit recompiles nothing.
#
# A build with generated GML (AOT_DIR) gets the set's tag from its aot_table.c: "+aot4" for the 4 MB
# set, "+aot12" for the 12 MB one. Test results then tell AOT builds apart from the rest at the same commit.
#
# usage: cmake -DSOURCE_DIR=<repo dir> -DOUT=<header> [-DGIT_EXECUTABLE=<git>] [-DAOT_DIR=<dir>] -P build_id.cmake

get_filename_component(release_root "${SOURCE_DIR}/../.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/release_contract.cmake")
release_read_contract("${release_root}")
set(commit "${RELEASE_archive_id_prefix}${RELEASE_VERSION}")
if(GIT_EXECUTABLE)
    # An extracted archive inside another checkout must use its own stamp,
    # rather than accidentally reporting the containing repository's HEAD.
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --show-toplevel
        WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE root_result
        OUTPUT_VARIABLE git_root OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 10)
    file(TO_CMAKE_PATH "${git_root}" git_root)
    file(TO_CMAKE_PATH "${release_root}" release_root)
    if(root_result EQUAL 0 AND git_root STREQUAL release_root)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 10)
    if(result EQUAL 0 AND hash)
        set(commit "${hash}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
            WORKING_DIRECTORY "${SOURCE_DIR}"
            RESULT_VARIABLE result OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 10)
        if(result EQUAL 0 AND changes)
            string(APPEND commit "-dirty")
        endif()
    endif()
    endif()
endif()

if(AOT_DIR)
    set(tag "aot")
    if(EXISTS "${AOT_DIR}/aot_table.c")
        file(STRINGS "${AOT_DIR}/aot_table.c" line REGEX "^const char aotBuildTag\\[\\] = \"[^\"]*\";")
        if(line MATCHES "= \"([^\"]*)\"")
            set(tag "${CMAKE_MATCH_1}")
        endif()
    elseif(EXISTS "${AOT_DIR}/aot_modules.txt")
        # One module per chapter (prepare.py --chapters): "+aot4ch".
        file(STRINGS "${AOT_DIR}/aot_modules.txt" line REGEX "^tag ")
        if(line MATCHES "^tag ([^ ]+)")
            set(tag "${CMAKE_MATCH_1}")
        endif()
    endif()
    # Numeric and ordinary tables retain the same aotBuildTag bytes. Mark the
    # separately generated numeric entry in the fixed-width build ID instead.
    if(EXISTS "${AOT_DIR}/aot_utold_loop.c")
        string(APPEND tag "n")
    endif()
    string(APPEND commit "+${tag}")
endif()

# main.c keeps the ID in a fixed-size array (source/ctr_build_id.h: a leading NUL, the ID and its NUL in 40 bytes), so
# its length never moves .rodata. Say so here rather than at the compiler's static assertion.
string(LENGTH "${commit}" length)
math(EXPR text_limit "${RELEASE_build_id_storage_bytes} - 2")
if(length GREATER text_limit)
    message(FATAL_ERROR "build ID '${commit}' has ${length} characters; release contract holds ${text_limit}")
endif()
set(content "// Generated by build_id.cmake on every build.\n#define CTRPORT_COMMIT_TEXT \"${commit}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
