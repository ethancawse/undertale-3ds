; Vertex shader for batches that sample up to three textures (texture units
; 0 to 2), so that draws alternating between them, such as an image that
; straddles texture tiles, need not each be a batch of their own.
;
; Inputs as render2d.v.pica. A vertex picks its texture by its z: the C side
; adds 64 * unit to the depth-mode shift (whole pixels, well inside +-32).
; Its own unit gets the texcoord render2d.v.pica would give it, exactly; the
; other units get t moved by 2 or 4, out of [0, 1], where their clamp-to-border
; wrap samples transparent black, which the texture combiner adds as nothing.

.fvec projection[4]

.constf consts(1.0, 0.00392156862745098, 0.015625, 32.0)
.constf units(0.0, 2.0, 4.0, 64.0)
.alias ONE consts.xxxx
.alias INV255 consts.yyyy
.alias INV64 consts.zzzz
.alias HALF_RANGE consts.wwww
.alias UNIT_SIZE units.wwww
.alias TWO units.yyyy

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.entry multi

.proc multi
    ; unit = floor((z + 32) / 64), z -= 64 * unit
    add r2.x, HALF_RANGE, inpos.z
    mul r2.x, INV64, r2.x
    flr r2.x, r2.x
    mul r2.y, UNIT_SIZE, r2.x
    mov r0.xyz, inpos
    add r0.z, inpos.z, -r2.y
    mov r0.w, ONE

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; v flipped as in render2d.v.pica, then each unit's shift: 2 * (k - unit),
    ; exactly zero for the vertex's own unit.
    mov r1, intex
    add r1.y, ONE, -intex.y
    mul r2.z, TWO, r2.x
    add r3, units, -r2.zzzz
    mov r4, r1
    add r4.y, r1.y, r3.x
    mov outtc0, r4
    add r4.y, r1.y, r3.y
    mov outtc1, r4
    add r4.y, r1.y, r3.z
    mov outtc2, r4
    mul outclr, INV255, inclr
    end
.end
