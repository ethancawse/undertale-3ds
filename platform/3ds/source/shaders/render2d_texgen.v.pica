; Vertex shader for draws that sample two textures besides the first at
; places given by where on the target they land: DELTARUNE Chapter 5's
; castle reflections look up an object surface by screen position and a
; mask by room position (see "Castle reflections" in ctr_renderer.c).
;
; Inputs and outputs as render2d.v.pica, with texcoord1 = (tg[0], tg[1]) .
; (x, y, z, 1) and texcoord2 = (tg[2], tg[3]) . (x, y, z, 1) of the vertex's
; world position, as the texture's s and t (v already flipped).

.fvec projection[4]
.fvec tg[4]

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)
.alias ONE consts.xxxx
.alias INV255 consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.entry texgen

.proc texgen
    mov r0.xyz, inpos
    mov r0.w, ONE

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; v flipped as in render2d.v.pica.
    mov r1, intex
    add r1.y, ONE, -intex.y
    mov outtc0, r1
    mov r2, intex
    dp4 r2.x, tg[0], r0
    dp4 r2.y, tg[1], r0
    mov outtc1, r2
    mov r3, intex
    dp4 r3.x, tg[2], r0
    dp4 r3.y, tg[3], r0
    mov outtc2, r3
    mul outclr, INV255, inclr
    end
.end
