; Vertex shader for batches that sample one or two textures besides the
; first at related places: a palette shader's two recoloured copies of a
; texture tile, which the texture combiner mixes (see "Palette shaders" in
; ctr_renderer.c), and the detail-keeping shrink's three neighbouring
; texels (see "Detail-keeping shrink").
;
; Inputs and outputs as render2d.v.pica, with texcoord1 = texcoord0 * tc1.xy
; + tc1.zw and texcoord2 = texcoord0 * tc2.xy + tc2.zw (before v is
; flipped): the textures may hold different parts of the image.

.fvec projection[4]
.fvec tc1
.fvec tc2

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)
.alias ONE consts.xxxx
.alias INV255 consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.entry pair

.proc pair
    mov r0.xyz, inpos
    mov r0.w, ONE

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; v flipped as in render2d.v.pica.
    mov r1, intex
    add r1.y, ONE, -intex.y
    mov outtc0, r1
    mov r2, intex
    mul r2.xy, tc1.xy, intex.xy
    add r2.xy, tc1.zw, r2.xy
    add r2.y, ONE, -r2.y
    mov outtc1, r2
    mov r3, intex
    mul r3.xy, tc2.xy, intex.xy
    add r3.xy, tc2.zw, r3.xy
    add r3.y, ONE, -r3.y
    mov outtc2, r3
    mul outclr, INV255, inclr
    end
.end
