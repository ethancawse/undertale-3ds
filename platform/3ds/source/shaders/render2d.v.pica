; 2D vertex shader for the citro3d renderer.
;
; Inputs: v0 = position (x, y, z), v1 = texcoord (u, v), v2 = colour as
; unsigned bytes. Positions go through a single matrix that already combines
; GameMaker's world, view and projection matrices with the render target's
; orientation, so the shader does no other work.

.fvec projection[4]

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)
.alias ONE consts.xxxx
.alias INV255 consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
    mov r0.xyz, inpos
    mov r0.w, ONE

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    ; The PICA samples v = 0 from the last row of a texture in memory. The C
    ; side keeps v = 0 at the first row (the top of every image), so flip it.
    mov r1, intex
    add r1.y, ONE, -intex.y
    mov outtc0, r1
    mul outclr, INV255, inclr
    end
.end
