# Single machine-readable release contract, shared with the builder.
function(release_read_contract root)
    file(READ "${root}/docs/release/build-contract.json" contract)
    string(JSON schema GET "${contract}" schema)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unsupported release contract schema: ${schema}")
    endif()
    foreach(key version_file archive_id_prefix build_id_storage_bytes package_stem development_source_base legal_columns legal_lines)
        string(JSON value GET "${contract}" "${key}")
        set(RELEASE_${key} "${value}" PARENT_SCOPE)
    endforeach()
    string(JSON version_file GET "${contract}" version_file)
    file(READ "${root}/${version_file}" version)
    string(STRIP "${version}" version)
    if(NOT version MATCHES "^([0-9]+\\.[0-9]+\\.[0-9]+)(-(alpha|beta|rc)\\.[1-9][0-9]*)?$")
        message(FATAL_ERROR "VERSION must contain major.minor.patch with an optional alpha.N/beta.N/rc.N label")
    endif()
    set(numeric "${CMAKE_MATCH_1}")
    set(prerelease "${CMAKE_MATCH_2}")
    string(REPLACE "." ";" parts "${numeric}")
    list(GET parts 0 major)
    list(GET parts 1 minor)
    list(GET parts 2 patch)
    if(major GREATER 63 OR minor GREATER 63 OR patch GREATER 15)
        message(FATAL_ERROR "VERSION exceeds CIA limits (major/minor 0-63, patch 0-15)")
    endif()
    math(EXPR final_cia "${major} * 1024 + ${minor} * 16 + ${patch}")
    set(cia "${numeric}")
    if(prerelease)
        string(JSON cia ERROR_VARIABLE allocation_error GET "${contract}" cia_prerelease_versions "${version}")
        if(allocation_error)
            message(FATAL_ERROR "No approved CIA allocation for ${version}")
        endif()
    endif()
    if(NOT cia MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "Invalid CIA allocation: ${cia}")
    endif()
    string(REPLACE "." ";" cia_parts "${cia}")
    list(GET cia_parts 0 cia_major)
    list(GET cia_parts 1 cia_minor)
    list(GET cia_parts 2 cia_patch)
    if(cia_major GREATER 63 OR cia_minor GREATER 63 OR cia_patch GREATER 15)
        message(FATAL_ERROR "CIA allocation exceeds CIA limits")
    endif()
    math(EXPR cia_integer "${cia_major} * 1024 + ${cia_minor} * 16 + ${cia_patch}")
    if(prerelease AND NOT cia_integer LESS final_cia)
        message(FATAL_ERROR "Prerelease CIA allocation must precede its final release")
    endif()
    set(RELEASE_NUMERIC_VERSION "${numeric}" PARENT_SCOPE)
    set(RELEASE_CIA_MAJOR "${cia_major}" PARENT_SCOPE)
    set(RELEASE_CIA_MINOR "${cia_minor}" PARENT_SCOPE)
    set(RELEASE_CIA_PATCH "${cia_patch}" PARENT_SCOPE)
    set(RELEASE_CIA_INTEGER "${cia_integer}" PARENT_SCOPE)
    set(RELEASE_VERSION "${version}" PARENT_SCOPE)
endfunction()

function(release_package_names game model)
    set(stem "${RELEASE_package_stem}")
    string(REPLACE "{game}" "${game}" stem "${stem}")
    string(REPLACE "{model}" "${model}" stem "${stem}")
    set(old_model "${RELEASE_package_stem}")
    # Keep the existing caller's game argument and instruction layout intact.
    string(REPLACE "{game}" "%s" old_model "${old_model}")
    string(REPLACE "{model}" "o3ds" old_model "${old_model}")
    if(NOT stem MATCHES "^[a-z0-9-]+$" OR NOT old_model MATCHES "^%s[a-z0-9-]+$")
        message(FATAL_ERROR "Unsafe package_stem in release contract")
    endif()
    set(RELEASE_PACKAGE_STEM "${stem}" PARENT_SCOPE)
    set(RELEASE_O3DS_FILENAME "${old_model}.3dsx" PARENT_SCOPE)
endfunction()
